[gd_resource type="Resource" script_class="NarrativeData" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/resources/NarrativeData.gd" id="1_narrative"]

[resource]
script = ExtResource("1_narrative")
narrative_id = "merchant_secrets"
dialogue_text = "The merchant leans closer, their mechanical eyes gleaming. 'Secrets have a price. But for you... I'll share one freely. Knowledge of the ancient machines - the art of self-repair.'"
choices = Array[Dictionary]([{
"outcome_type": "grant_passive",
"outcome_value": "self_repair",
"text": "Accept the knowledge"
}, {
"outcome_type": "end",
"outcome_value": "",
"text": "\"I'll pass.\" (Leave)"
}])
