[gd_resource type="Resource" script_class="NarrativeData" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/resources/NarrativeData.gd" id="1_narrative"]

[resource]
script = ExtResource("1_narrative")
narrative_id = "strange_merchant"
dialogue_text = "A hooded figure emerges from the shadows, their voice a mechanical rasp. 'I deal in more than scrap, wanderer. Interested in my... special wares?'"
choices = Array[Dictionary]([{
"outcome_type": "next_narrative",
"outcome_value": "merchant_weapons",
"text": "\"Show me your weapons.\""
}, {
"outcome_type": "next_narrative",
"outcome_value": "merchant_secrets",
"text": "\"What secrets do you offer?\""
}, {
"outcome_type": "end",
"outcome_value": "",
"text": "\"Not interested.\" (Leave)"
}])
